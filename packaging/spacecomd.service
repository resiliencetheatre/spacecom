[Unit]
Description=Spacecom bidirectional NORM file delivery
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spacecom
Group=spacecom
ExecStart=/usr/local/bin/spacecomd /etc/spacecom.conf
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/spacecom /var/spool/spacecom

[Install]
WantedBy=multi-user.target
